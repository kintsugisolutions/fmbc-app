# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ── n8n ──────────────────────────────────────────────────────────────────────
# Your n8n Search Intake webhook URL
# Get this from: n8n → Workflow 1 → Webhook node → copy URL
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/user-search

# Shared secret sent as X-FMBC-Secret header with every webhook call.
# Generate any strong random string (e.g. openssl rand -hex 32).
# Set the same value in your n8n webhook node under Header Auth → Value.
# Optional but strongly recommended before going live.
N8N_WEBHOOK_SECRET=your_secret_here

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get from: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Upstash Redis (production rate limiting — required on Vercel) ─────────────
# Create free account at https://upstash.com → create a Redis database
# Copy the REST URL and REST Token from the dashboard.
# See the comment block in app/api/search/route.ts for how to activate.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
